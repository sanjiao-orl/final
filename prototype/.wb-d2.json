{"action":"evaluate","args":{"code":"(async()=>{const app=document.getElementById('app');app.classList.remove('show-settings');app.classList.add('show-approval');await new Promise(r=>setTimeout(r,800));const ov=document.getElementById('approval-overlay');const cs=getComputedStyle(ov);const card=ov.querySelector('.approval-card').getBoundingClientRect();return JSON.stringify({op:cs.opacity,pe:cs.pointerEvents,card:{x:card.x,y:card.y,w:card.width,h:card.height}})})()"},"session":"shell-proto-review"}