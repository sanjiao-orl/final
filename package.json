{
  "name": "novel-ws",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "domain",
    "shell"
  ],
  "scripts": {
    "dev:core": "npm run dev -w core",
    "dev:domain": "npm run dev -w domain",
    "dev:shell": "npm run dev -w shell",
    "test": "npm test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present && node scripts/check-versions.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "promptfoo": "promptfoo eval -c scripts/promptfoo/promptfooconfig.yaml",
    "build": "npm run build --workspaces --if-present",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "promptfoo": "^0.122.0"
  }
}
