{
  "name": "shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "小说写作工作台的 Tauri 壳（Tauri 2 + Svelte 5 + TipTap，纯渲染零产品逻辑，数据面走 core sidecar）",
  "scripts": {
    "dev": "node scripts/dev-env.mjs",
    "dev:vite": "vite",
    "build": "vite build",
    "build:sidecar": "node ../scripts/build-sidecar.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tauri-apps/cli": "^2.9.4",
    "@types/turndown": "^5.0.5",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tiptap/core": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "marked": "^16.4.0",
    "turndown": "^7.2.2"
  }
}
