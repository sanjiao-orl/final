{
  "name": "core",
  "version": "0.2.10",
  "private": true,
  "type": "module",
  "description": "小说写作工作台的 Node sidecar 核心：本地 HTTP/SSE 服务、会话持久化、LLM 接入、MCP 领域工具（UI 无关，被 Tauri 壳与浏览器联调页消费）",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "node ../scripts/build-sidecar.mjs --only core",
    "check": "tsc --noEmit -p .",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.29",
    "@ai-sdk/openai-compatible": "^3.0.27",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.58",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.7",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
